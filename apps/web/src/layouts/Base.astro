---
// src/layouts/Base.astro — sitewide shell: head meta (canonical, favicon),
// header nav, footer. JavaScript is enhancement-only (AGENTS.md rule 4):
// the two scripts (/js/theme.js — the light/dark/system theme toggle,
// owner ruling 2026-11-10 — and /js/copy.js — the copy buttons) are
// static assets loaded with `defer`; every page works fully without them
// (system theme follows the OS media query, copy falls back to
// click-to-select).
// Page-specific JSON-LD is injected via the `schema` prop and MUST mirror
// the visible copy.
import '../styles/global.css'
import Robot from '../components/Robot.astro'

interface Props {
  title: string
  description: string
  ogType?: 'website' | 'article'
  schema?: Record<string, unknown>
}

const { title, description, ogType = 'website', schema } = Astro.props
const fullTitle = title === 'Droid Skills' ? title : `${title} — Droid Skills`
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- ?v=2 cache-buster: browsers cache favicons far beyond normal
         asset caching, so the version param forces a re-fetch when the
         mark changes (v2 = nerdy-glasses robot, 2026-11-10). Bump the
         number on any future mark change. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- llms.txt v2 recommendation (verified from llmstxt.org, retrieved
         2026-11-10): rel="describedby" points at the llms.txt file that
         covers this site. -->
    <link rel="describedby" href="/llms.txt" />
    <!-- The enhancement scripts (rule 4). defer = DOM ready at run.
         theme.js comes first so a saved explicit theme applies before
         anything else touches the DOM. -->
    <script src="/js/theme.js" defer></script>
    <script src="/js/copy.js" defer></script>

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Droid Skills" />
    <!-- This brand's own card (public/og-image.png, generated 2026-11-10
         via the image-generation skill — never reuse a sibling's art).
         twitter:* meta stays omitted: no X identity exists for this
         site yet. -->
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Droid Skills — skill files for Android AI agents" />

    <slot name="head" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="border-b border-line">
      <nav class="container flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-4">
        <a href="/" class="wordmark">
          <Robot class="h-10 w-10 sm:h-12 sm:w-12" />
          Droid <span class="rounded-md bg-brand px-1.5 text-onbrand">SKILL</span>s
        </a>
        <div class="flex items-center gap-5">
          <a href="/SKILL.md" class="font-semibold no-underline">SKILL.md</a>
          <a href="/skills/" class="font-semibold no-underline">All Skills</a>
          <a href="/about" class="font-semibold no-underline">About</a>
          <!-- GitHub link (owner ruling 2026-11-10: a PRETTY button in
               the header + a normal text link in the footer — the first
               external link this site ships; rule 9 amended. The
               externalLinksNewTab build hook auto-adds target/rel). -->
          <a href="https://github.com/nyusternie/droid-skills" class="gh-link">
            <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.95-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
            GitHub
          </a>
          <!-- Theme toggle (owner ruling 2026-11-10: light / dark /
               system, defaulting to system). hidden: /js/theme.js
               reveals it and cycles the states, persisting to
               localStorage. No-JS: the button never appears and the
               system media query themes the page (rule 4 parity). -->
          <button id="theme-toggle" class="theme-toggle" type="button" hidden>theme: system</button>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t border-line">
      <div class="container flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-8 text-sm muted">
        <p>Droid Skills · Skill files for Android AI agents · <a href="https://github.com/nyusternie/droid-skills">GitHub</a></p>
        <p class="text-right">Public domain, no rights reserved (CC0 1.0).</p>
      </div>
    </footer>
  </body>
</html>
