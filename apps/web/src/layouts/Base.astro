---
// src/layouts/Base.astro — sitewide shell: head meta (canonical, favicon),
// header nav, footer. JavaScript is enhancement-only (AGENTS.md rule 4):
// the two scripts (/js/theme.js — the light/dark/system theme toggle,
// owner ruling 2026-11-10 — and /js/copy.js — the copy buttons) are
// static assets loaded with `defer`; every page works fully without them
// (system theme follows the OS media query, copy falls back to
// click-to-select).
// Page-specific JSON-LD is injected via the `schema` prop and MUST mirror
// the visible copy.
import '../styles/global.css'
import Robot from '../components/Robot.astro'

interface Props {
  title: string
  description: string
  ogType?: 'website' | 'article'
  schema?: Record<string, unknown>
}

const { title, description, ogType = 'website', schema } = Astro.props
const fullTitle = title === 'Droid Skills' ? title : `${title} — Droid Skills`
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- ?v=3 cache-buster: browsers cache favicons far beyond normal
         asset caching, so the version param forces a re-fetch when the
         mark changes (v3 = pseudo-3D robot, 2026-11-11). Bump the
         number on any future mark change. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- llms.txt v2 recommendation (verified from llmstxt.org, retrieved
         2026-11-10): rel="describedby" points at the llms.txt file that
         covers this site. -->
    <link rel="describedby" href="/llms.txt" />
    <!-- The enhancement scripts (rule 4). defer = DOM ready at run.
         theme.js comes first so a saved explicit theme applies before
         anything else touches the DOM. -->
    <!-- ?v=N cache-busters on the scripts too (owner report 2026-11-11:
         a stale cached theme.js kept serving the OLD theme cycler after
         the picker shipped). Bump the version whenever the file changes. -->
    <script src="/js/theme.js?v=2" defer></script>
    <script src="/js/copy.js" defer></script>

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Droid Skills" />
    <!-- This brand's own card (public/og-image.png, generated 2026-11-10
         via the image-generation skill — never reuse a sibling's art).
         twitter:* meta stays omitted: no X identity exists for this
         site yet. -->
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Droid Skills — skill files for Android AI agents" />

    <slot name="head" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="border-b border-line">
      <nav class="container flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-4">
        <a href="/" class="wordmark">
          <Robot class="h-10 w-10 sm:h-12 sm:w-12" />
          <!-- The wordmark text is wrapped in ONE span so .wordmark's
               flex gap lands between the robot and the text as a whole —
               without it the trailing "s" becomes its own flex item and
               reads as "SKILL s" (owner report 2026-11-11). The accent
               span is a pure color highlight, no spacing. -->
          <span>Droid <span class="text-accent">SKILL</span>s</span>
        </a>
        <div class="flex items-center gap-5">
          <a href="/SKILL.md" class="font-semibold no-underline">SKILL.md</a>
          <a href="/skills/" class="font-semibold no-underline">All Skills</a>
          <a href="/about" class="font-semibold no-underline">About</a>
          <!-- Theme picker (owner ruling 2026-11-11: the button shows
               the CURRENT theme as an icon; CLICKING opens a menu of
               three choices — Light / Dark / System — and a pick swaps
               the button icon. Supersedes the 2026-11-10 cycle-on-click
               selector). Default is SYSTEM when nothing is saved;
               picks persist to localStorage via /js/theme.js. No-JS:
               the button never appears and the system media query
               themes the page (rule 4 parity). -->
          <div class="relative">
            <button id="theme-toggle" class="theme-toggle" type="button" hidden
                    aria-haspopup="menu" aria-expanded="false" aria-controls="theme-menu">
              <svg data-theme-icon="system" viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="9" rx="1.5"/><path d="M5.5 14h5M8 11.5V14"/></svg>
              <svg data-theme-icon="light" viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M12.6 3.4l-1 1M4.4 11.6l-1 1"/></svg>
              <svg data-theme-icon="dark" viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 9.2A6 6 0 1 1 6.8 2a4.8 4.8 0 0 0 7.2 7.2Z"/></svg>
            </button>
            <!-- The picker menu. JS sets aria-checked on the active
                 option; ALL of its visuals (accent color, checkmark)
                 come from CSS keyed on that attribute. -->
            <div id="theme-menu" class="theme-menu" role="menu" aria-label="Theme" hidden>
              <button class="theme-option" role="menuitemradio" type="button" data-theme-value="light" aria-checked="false">
                <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M12.6 3.4l-1 1M4.4 11.6l-1 1"/></svg>
                Light
                <svg viewBox="0 0 16 16" class="theme-option-check h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4"/></svg>
              </button>
              <button class="theme-option" role="menuitemradio" type="button" data-theme-value="dark" aria-checked="false">
                <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 9.2A6 6 0 1 1 6.8 2a4.8 4.8 0 0 0 7.2 7.2Z"/></svg>
                Dark
                <svg viewBox="0 0 16 16" class="theme-option-check h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4"/></svg>
              </button>
              <button class="theme-option" role="menuitemradio" type="button" data-theme-value="system" aria-checked="false">
                <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="9" rx="1.5"/><path d="M5.5 14h5M8 11.5V14"/></svg>
                System
                <svg viewBox="0 0 16 16" class="theme-option-check h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4"/></svg>
              </button>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t border-line">
      <div class="container flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-8 text-sm muted">
        <p>Droid Skills · Skill files for Android AI agents</p>
        <!-- GitHub icon link (owner ruling 2026-11-10: icon-only, lives
             in the FOOTER — superseding the same-day header-button +
             footer-text placement; the first external link this site
             ships, rule 9 amended. The externalLinksNewTab build hook
             auto-adds target/rel). -->
        <a href="https://github.com/nyusternie/droid-skills" class="gh-link" aria-label="Droid Skills on GitHub">
          <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.95-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        </a>
        <p class="text-right">Public domain, no rights reserved (CC0 1.0).</p>
      </div>
    </footer>
  </body>
</html>
