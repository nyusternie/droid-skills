---
// src/pages/404.astro — the not-found page. Zero JavaScript.
import Base from '../layouts/Base.astro'
import Robot from '../components/Robot.astro'
---

<Base
  title="404 — skill not found"
  description="The page or skill you asked for is not on this shelf."
>
  <section class="container py-20 text-center">
    <Robot class="mx-auto mb-4 h-24 w-24" animated />
    <h1 class="mb-4 font-display text-3xl font-extrabold tracking-wide">404 — skill not found</h1>
    <p class="mb-8 text-lg muted">
      The page or skill you asked for is not on this shelf. This site never redirects, so if you
      followed an old link, the file is retired — the shelf is the current catalog.
    </p>
    <a href="/skills/" class="btn no-underline">Back to the shelf</a>
  </section>
</Base>
