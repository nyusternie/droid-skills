---
// src/pages/index.astro — the landing page: what the site is, the skill
// shelf (rendered from the skills collection), and how agents consume the
// files. JavaScript is enhancement-only (AGENTS.md rule 4). JSON-LD mirrors the visible
// copy.
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Robot from '../components/Robot.astro'
import CopyBlock from '../components/CopyBlock.astro'
import { withoutDrafts, sortByOrderAsc } from '../lib/skills'

const skills = sortByOrderAsc(withoutDrafts(await getCollection('skills')))
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Droid Skills',
  url: 'https://droidskills.dev/',
  description:
    'Skill files for Android AI agents — verified, dated, fetchable over plain HTTP.',
}
---

<Base
  title="Droid Skills"
  description="Skill files for Android AI agents — verified, dated, fetchable over plain HTTP."
  schema={schema}
>
  <section class="relative overflow-hidden">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container relative py-16 text-center">
      <div class="relative mx-auto mb-6 h-36 w-36 sm:h-44 sm:w-44">
        <div class="hero-glow inset-0" aria-hidden="true"></div>
        <Robot class="relative h-full w-full" animated />
      </div>
      <p class="kicker">Skill files for Android AI agents</p>
      <h1 class="mx-auto mb-4 max-w-2xl font-display text-3xl font-extrabold tracking-wide sm:text-4xl">
        Step-by-step instructions for your Android to do just about <span class="text-accent">ANYTHING!</span>
      </h1>
      <p class="mx-auto mb-8 max-w-xl text-lg muted">
        Droid Skills publishes SKILL.md files — verified, dated corrections to stale model knowledge
        about Android, fetchable by any agent over plain HTTP. No accounts, no email, no API keys.
      </p>
      <div class="mx-auto max-w-xl text-left">
        <CopyBlock command="curl https://droidskills.dev/SKILL.md" />
      </div>
    </div>
  </section>

  <!-- Decorative terminal: the two fetches every session starts with, typed
       and answered purely in CSS — the animations stay JS-free (rule 4). The output lines are the
       real frontmatter prefixes served at those URLs. -->
  <section class="container py-8" aria-hidden="true">
    <div class="term">
      <div class="term-bar">
        <span class="term-dot bg-red-400"></span>
        <span class="term-dot bg-amber-400"></span>
        <span class="term-dot bg-brand"></span>
      </div>
      <div class="term-body">
        <p class="term-type term-type-1">$ curl https://droidskills.dev/SKILL.md</p>
        <p class="term-out term-out-1">name: droidskills</p>
        <p class="term-out term-out-2">description: Use when a request involves Android — …</p>
        <p class="term-type term-type-2">$ curl https://droidskills.dev/adb/SKILL.md</p>
        <p class="term-out term-out-3">name: "adb"</p>
        <p class="term-final">$<span class="term-caret"></span></p>
      </div>
    </div>
  </section>

  <section class="container py-8">
    <h2 class="mb-4 text-2xl font-bold">The starting prompt</h2>
    <p class="mb-4 max-w-xl muted">
      Paste this at the start of any agent session that can fetch URLs — the agent reads the root
      skill first, then pulls only the per-topic skills it needs.
    </p>
    <CopyBlock command="Read https://droidskills.dev/SKILL.md and follow it before building, debugging, or inspecting anything on Android." />
    <p class="mt-3 text-sm muted">
      Per session. The button copies the whole prompt in one click; with JavaScript off,
      one click selects it instead (rule 4: JavaScript is enhancement only, never a gate).
    </p>
  </section>

  <!-- Preview only — the FULL shelf is its own page at /skills/ (owner
       ruling 2026-11-10: no hashtag anchors for skills). -->
  <section class="container py-8">
    <div class="mb-6 flex items-end justify-between gap-4">
      <h2 class="text-2xl font-bold">Fresh off the shelf</h2>
      <a href="/skills/" class="shrink-0 font-semibold">All skills →</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      {
        skills.map((skill) => (
          <a
            href={`/${skill.id}/`}
            class="card block no-underline transition duration-200 hover:-translate-y-1 hover:border-accent hover:shadow-lg"
          >
            <h3 class="mb-1 text-xl font-bold text-ink">{skill.data.title}</h3>
            <p class="muted text-sm">{skill.data.summary}</p>
            <p class="mt-3 font-mono text-xs text-accent">/{skill.id}/SKILL.md</p>
          </a>
        ))
      }
    </div>
    <div class="mt-8 text-center">
      <a href="/skills/" class="btn no-underline">Browse the full shelf</a>
    </div>
  </section>

  <section class="container py-8">
    <h2 class="mb-4 text-2xl font-bold">Why this exists</h2>
    <div class="skill-body">
      <p>
        Android moves faster than any model's training data. API levels drift, commands deprecate,
        defaults change. Dated, verified skill files are the correction mechanism: an agent fetches
        the current facts before it acts, instead of reasoning from stale memory.
      </p>
      <p>
        Every skill follows the same ground rules: dated claims name their retrieval date and
        source page; unknowns print as unknowns, never as guesses; inspection is read-only on the
        device. Everything here is public domain (CC0 1.0) — take it, remix it, serve it to your
        own agents.
      </p>
    </div>
  </section>
</Base>
