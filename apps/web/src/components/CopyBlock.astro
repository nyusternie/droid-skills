---
// src/components/CopyBlock.astro — a terminal-styled command block with a
// TRUE one-click "copy to clipboard" button (owner ruling 2026-11-10
// amends rule 4: JS as enhancement only). The button renders with
// `hidden`; /js/copy.js (defer) reveals + wires it via the Clipboard API.
// With JavaScript off the button never appears and the block still works:
// one click on the command selects it whole (user-select: all), and the
// hint chip says so. The command is the ONLY text node inside the <code> —
// no prompt glyph — so neither copy path can capture anything else.
interface Props {
  command: string
  hint?: string
}

const { command, hint = 'click to select · Ctrl/Cmd+C to copy' } = Astro.props
---

<div class="copyblock">
  <code class="copyblock-code">{command}</code>
  <button class="copyblock-btn" type="button" hidden>Copy</button>
  <span class="copyblock-hint">{hint}</span>
</div>
